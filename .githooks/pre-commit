#!/usr/bin/env bash
# Fast checks before every commit: formatting + lints.
# Skip in an emergency with: git commit --no-verify
set -euo pipefail

echo "pre-commit: cargo fmt --all --check"
cargo fmt --all --check

echo "pre-commit: cargo clippy --workspace --all-targets -- -D warnings"
cargo clippy --workspace --all-targets -- -D warnings
